[user]
    name = Paul Kirth
    email = pk1574@gmail.com

[includeIF "gitdir:/usr/local/google/"]
    path = .work.gitconfig

[difftool]
    prompt = false

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true # use n and N to move between diff sections
    light = false    # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)

[diff]
    colorMoved = default

[merge]
    conflictstyle = diff3

[mergetool]
    prompt = false
    keepBackup = false
    keepTemporaries = false

[push]
    default = simple

[color]
  pager = true
  ui = auto
  status = auto
  diff = auto
  branch = auto
  showBranch = auto
  interactive = auto
  grep = auto
[color "status"]
  header = black bold
  branch = cyan
  nobranch = red
  unmerged = red
  untracked = cyan
  added = green
  changed = red bold
[color "diff"]
  meta = red bold
  frag = blue bold
  func = blue
  old = red strike
  new = green
  commit = blue
  whitespace = red
  context = normal
[color "branch"]
  current = cyan
  local = blue
  remote = magenta
  upstream = magenta
  plain = normal
[color "decorate"]
  branch = blue
  remoteBranch = magenta
  tag = magenta
  stash = cyan
  HEAD = blue
[color "interactive"]
  prompt = red
  header = red bold
  error = red
  help = black bold
[color "grep"]
  context = normal
  match = cyan
  filename = blue
  function = blue
  selected = normal
  separator = red bold
  linenumber = normal

[core]
    editor = nvim
    pager = delta --diff-so-fancy
    untrackedCache = true
    fsmonitor = true

[color "diff-highlight"]
    oldNormal = red strike
    oldHighlight = red strike 52
    newNormal = green bold
    newHighlight = green bold 22

[pull]
    rebase = true

[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[repo]
	superprojectChoiceExpire = 1718734902
	superprojectChoice = true
[http]
	cookiefile = /usr/local/google/home/paulkirth/.gitcookies
[url "sso://android/"]
	insteadOf = https://android.googlesource.com/
	insteadOf = https://android-review.googlesource.com/
	insteadOf = http://android.googlesource.com/
	insteadOf = http://android-review.googlesource.com/
[protocol "sso"]
       allow = always
[credential]
       helper = corpsso
[url "persistent-https://partner-android-review.googlesource.com/"]
       insteadOf = https://partner-android-review.googlesource.com/
[url "persistent-https://partner-android.googlesource.com/"]
       insteadOf = https://partner-android.googlesource.com/
[url "persistent-https://googleplex-android-review.googlesource.com/"]
       insteadOf = https://googleplex-android-review.googlesource.com/
[url "persistent-https://googleplex-android.googlesource.com/"]
       insteadOf = https://googleplex-android.googlesource.com/
[url "persistent-https://googleplex-polygon-android.googlesource.com/"]
       insteadOf = https://googleplex-polygon-android.googlesource.com/
[url "persistent-https://partner-polygon-android.googlesource.com/"]
       insteadOf = https://partner-polygon-android.googlesource.com/
[url "sso://pigweed"]
	insteadof = https://pigweed.googlesource.com
	insteadof = https://pigweed.git.corp.google.com
[url "sso://pigweed-internal"]
	insteadof = https://pigweed-internal.googlesource.com
	insteadof = https://pigweed-internal.git.corp.google.com
